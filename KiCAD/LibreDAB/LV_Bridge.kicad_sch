	(text "Gate driver pins"
		(exclude_from_sim no)
		(at 116.078 68.834 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "3ef61676-6cc2-4bf0-9a29-98172433bc84")
	)
	(text "Gate driver pins"
		(exclude_from_sim no)
		(at 175.768 68.326 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "438d9a4c-7fe5-4816-af70-c24bca72732f")
	)
	(text "At 80 V maximum voltage, aim for voltage divider to produce 2 V.\n2 / 80 = 0.025 ratio\nFixing top resistor at 1 MOhm\nBottom resistor = 0.025 x 1 Mohm = 25 k\n\n25.5 k is closest value. This will cap the range slightly below 80 V.\n\n1 nF capacitor for minimal low pass filtering."
		(exclude_from_sim no)
		(at 89.662 42.926 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "6ae2942b-d19e-47b9-8bfb-438323f7cc59")
	)
	(text "Screw Terminals"
		(exclude_from_sim no)
		(at 32.766 69.088 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "78e4ca8f-2dcf-4bb9-8406-9d81aa8476b7")
	)
	(text "Stored energy: 0.5 CV^2\n0.5 * 45u * 80^2 = 0.144 J\nDischarge time constant: RC\n~ 1M * 47u = 45 seconds"
		(exclude_from_sim no)
		(at 38.862 79.756 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "7e0f44a3-b9b7-498e-9582-17fe8a265370")
	)
	(text "Screw Terminals"
		(exclude_from_sim no)
		(at 236.22 55.626 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "d6338c9d-d5a2-46a6-ac43-32afc1e3daed")
	)
	(text "Ipeak = 60 A, bidirectional in short circuit condition\nAiming for ~ 72 mV at full range based on uVerter design\nR = V/I = 72m/60 = 1.2 mOhm\nAim for 1 mOhm resistor\n\nCheck losses: I^2 R = 60^2 * 1m = 3.6 Watts\nAt nominal 35 A: 35^2*1m = 1.225 Watts\n\nFor thermal capacity, use 5 x 5 mOhm in parallel. Total power rating 5 x 3 W = 15 W. \n"
		(exclude_from_sim no)
		(at 94.234 142.24 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "e429b8ce-c0d7-493b-a7e3-42e745ccc387")
	)
	(text "Voltage and Current sense passives"
