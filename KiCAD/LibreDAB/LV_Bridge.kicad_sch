			)
		)
		(uuid "3ef61676-6cc2-4bf0-9a29-98172433bc84")
	)
	(text "Gate driver pins"
		(exclude_from_sim no)
		(at 192.532 74.93 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "438d9a4c-7fe5-4816-af70-c24bca72732f")
	)
	(text "At 80 V maximum voltage, aim for voltage divider to produce 2 V.\n2 / 80 = 0.025 ratio\nFixing top resistor at 1 MOhm\nBottom resistor = 0.025 x 1 Mohm = 25 k\n\n25.5 k is closest value. This will cap the range slightly below 80 V.\n\n1 nF capacitor for minimal low pass filtering."
		(exclude_from_sim no)
		(at 89.662 42.926 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "6ae2942b-d19e-47b9-8bfb-438323f7cc59")
	)
	(text "Screw Terminals"
		(exclude_from_sim no)
		(at 32.766 69.088 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "78e4ca8f-2dcf-4bb9-8406-9d81aa8476b7")
	)
	(text "Stored energy: 0.5 CV^2\n0.5 * 45u * 80^2 = 0.144 J\nDischarge time constant: RC\n~ 1M * 47u = 45 seconds"
		(exclude_from_sim no)
		(at 38.862 79.756 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "7e0f44a3-b9b7-498e-9582-17fe8a265370")
	)
	(text "Voltage Sense buffer"
		(exclude_from_sim no)
		(at 51.308 156.464 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "8ee08793-7d9d-4085-af7c-d5993232a7f5")
	)
	(text "1.024 V reference for \nmeasurement offset"
		(exclude_from_sim no)
		(at 112.522 154.686 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "c5a4eb05-3989-4f93-bd99-b6d8c7a8a7ea")
	)
	(text "When R2 = R4 and R1 = R3, equation 13 reduces to equation 14.\nVOUT  = (V1 - V2) * (R4/R3)"
		(exclude_from_sim no)
		(at 324.866 160.274 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "cf66a2a7-8352-4345-876b-bf55e93082ae")
	)
	(text "Screw Terminals"
		(exclude_from_sim no)
		(at 236.22 55.626 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "d6338c9d-d5a2-46a6-ac43-32afc1e3daed")
	)
	(text "Peak current sense voltage of +/-30 mV\nNeed this to equate to +/- 1V with +1V offset\nGain = 1/0.03 = 33.33\n\nGain is defined by R4 / R3.\nR3 fixed at 10k, R4 = 10k*33.33 = 333.33k.\nClosest real value is 330k. \n\n-> Gain of 33.0 \n30 mV will translate to 990 mV"
		(exclude_from_sim no)
		(at 224.79 118.364 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "e31dd685-4cf6-44ec-8f49-97d302c5b101")
	)
	(text "Ipeak = 60 A, bidirectional in short circuit condition\nSmallest 2512 Resistor is 0.5 mOhm\nCheck losses:\nI^2R = 60^2 * 0.5m = 1.8 Watts at short circuit condition\nI^2R = 35^2 * 0.5m = 0.61 Watts at max normal current\n\nCheck voltage drop:\nV = IR = 60*0.5m = 30 mV"
		(exclude_from_sim no)
		(at 79.248 116.078 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "e429b8ce-c0d7-493b-a7e3-42e745ccc387")
	)
	(text "Voltage and Current sense passives"
		(exclude_from_sim no)
		(at 95.758 57.404 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "ea903d20-468e-4f6c-96c3-aecdde46a339")
	)
	(text "Filter cutoff ~ 6.2 kHz"
